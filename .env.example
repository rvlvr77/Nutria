# =====================================================================
# NutriAI — variables de entorno
# Copia este archivo:  cp .env.example .env
# Nunca subas .env al repositorio.
# =====================================================================

# ---------- App ----------
# development | test | staging | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Orígenes permitidos por CORS, separados por coma (no usar * en producción)
CORS_ORIGINS=http://localhost:3000

# ---------- PostgreSQL 15 ----------
POSTGRES_USER=nutriai
POSTGRES_PASSWORD=nutriai
POSTGRES_DB=nutriai
POSTGRES_PORT=5432
# Para ejecutar el backend FUERA de Docker. Dentro de docker compose se sobrescribe con host "db".
DATABASE_URL=postgresql+asyncpg://nutriai:nutriai@localhost:5432/nutriai
DATABASE_ECHO=false

# ---------- Redis 7 ----------
REDIS_PORT=6379
# Fuera de Docker. Dentro de docker compose se sobrescribe con host "redis".
REDIS_URL=redis://localhost:6379/0

# ---------- Puertos expuestos ----------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------- Auth / JWT (Módulo 2) ----------
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatorio (>= 32 caracteres) cuando ENVIRONMENT=production.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# OAuth 2.0 Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ---------- Cifrado de datos de salud (medical_conditions) ----------
# Clave Fernet (base64, 32 bytes). Genera con:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Obligatoria en producción. Si la pierdes, los datos cifrados son irrecuperables.
FIELD_ENCRYPTION_KEY=

# ---------- USDA FoodData Central (Módulo 5) ----------
# Clave gratuita: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_RATE_LIMIT_PER_HOUR=1000
USDA_FOOD_CACHE_TTL_DAYS=30
USDA_SEARCH_CACHE_TTL_DAYS=7

# ---------- LLM (Módulo 7) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ---------- Reglas de negocio ----------
PLAN_GENERATIONS_PER_DAY=10

# ---------- Frontend (Next.js) ----------
# URL pública de la API vista desde el navegador
NEXT_PUBLIC_API_URL=http://localhost:8000/api
